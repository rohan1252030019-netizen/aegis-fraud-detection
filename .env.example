# ═══════════════════════════════════════════════════════════════════════
# AEGIS Platform - Environment Example Configuration
# ═══════════════════════════════════════════════════════════════════════

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=aegis_super_secret_jwt_key_development_32chars_min_length_ok
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_password@localhost:5432/aegis
DB_USER=aegis
DB_PASSWORD=aegis_dev_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aegis

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CELERY_DB=1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM (Investigation Assistance Only)
LLM_PROVIDER=none
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Uploads & CORS
MAX_UPLOAD_SIZE_MB=250
UPLOAD_DIR=C:/Users/ADMIN/Documents/EDI PROJECT/aegis/uploads
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
